# Build
target/

# Lokalny stan agenta: SQLite (WAL) i transkrypty sesji
.agent/
*.db
*.db-wal
*.db-shm

# Narzędzia lokalne: Craft Anything, magic context, unlazy
.cortexkit/
.unlazy/locks/
feed.json
usage.json

# Klon wzorcowy do RE (xai-org/grok-build) — odtwarzalny z upstreamu,
# ma własne .git i 1,4 GB z `target/`; notatki z RE zostają w docs/re/.
reference/grok-build/

# Resztki testów na żywo w katalogu budowania
app/a.txt
app/notatka.txt
app/raport.txt

# Dowody generowane przy kazdym `make verify`: logi i evidence.json maja czasy,
# ktore zmieniaja sie bez zmiany kodu. W historii trzymamy zrzuty i README,
# a pelny dowod jest artefaktem przebiegu (lokalnie: checks/evidence.json).
checks/*.log
checks/evidence.json
craft.json

# Python bytecode z generatora fixture (app/web/)
__pycache__/
*.pyc

# Artefakty wydania (binarka), nie historia
dist/
